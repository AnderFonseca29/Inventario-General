{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "cd frontend && npm ci && npm run build -- --configuration production",
  "outputDirectory": "frontend/dist/frontend/browser",
  "installCommand": "echo skip",
  "rewrites": [
    { "source": "/api", "destination": "https://inventario-backend-gsd7.onrender.com/api" },
    { "source": "/api/:path*", "destination": "https://inventario-backend-gsd7.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
