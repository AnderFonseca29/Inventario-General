# EditorConfig - Stockora
# https://editorconfig.org
#
# Objetivo: que TODO el repositorio se guarde en UTF-8 sin BOM y con
# saltos de linea consistentes, para evitar codificacion rota (mojibake).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{ts,js,mjs,cjs,json,html,scss,css,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
