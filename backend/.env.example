# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a Git.

# Conexion a PostgreSQL (administrada con pgAdmin).
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/inventario_saas?schema=public"

# Secretos JWT (genera valores aleatorios largos y distintos por entorno).
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200,https://anderfonseca29.github.io

# Tiempo maximo (segundos) que se cachean los permisos de un usuario.
# 0 desactiva la cache (consulta siempre a la base de datos).
PERMISOS_CACHE_TTL_SEGUNDOS=60

# Correo transaccional (verificacion de cuenta). Apagado: no hay proveedor
# configurado y las cuentas quedan verificadas para no bloquear el registro.
EMAIL_ENABLED=false

# CAPTCHA de Cloudflare Turnstile. Apagado: sin llaves el registro funciona
# sin CAPTCHA. Para activarlo crea el sitio en Cloudflare, define las llaves y
# pon TURNSTILE_ENABLED=true (el cliente tambien debe mostrar el widget).
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
